{
    "id": "belonging_prediction_raw_cnn_lstm_csv_v1",
    "log_filename": "belonging_results.csv",
    "seed": 42,
    "deterministic": true,
    "label_sweep": {
        "enabled": true,
        "label_types": ["specific", "composite", "factor", "weighted"]
    },
    "dataset_params": {
        "name": "load_belonging_raw_csvs",
        "raw_data_dir": "D:\\Cal-Poly-EEG-Data\\cleaned_v3",
        "labels_csv": "specific",
        "labels_lookup_csv": "data/belonging/andrews_40_subjects/AllNLPData.csv",
        "question_mode": "non cognitive",
        "max_windows_per_question": 23,
        "samples_per_window": 256,
        "window_stride": 128,
        "channels": ["TP9", "AF7", "AF8", "TP10"]
    },
    "preprocessor_params": {
        "name": "sequence_preprocessor",
        "test_split": 0.0,
        "val_split": 0.0,
        "batch_size": 1,
        "cv_folds": 5,
        "fold_manifest_csv": "data/belonging/andrews_40_subjects/final_results_paper_cv_manifest.csv",
        "cv_fold_as_test": true,
        "downsample_train": false,
        "max_windows_per_person": null,
        "seed": 42
    },
    "model_params": {
        "name": "RawCNNLSTM",
        "conv_filters": 8,
        "num_blocks": 2,
        "lstm_hidden_size": 16,
        "dropout_rate": 0.3,
        "use_batch_norm": true,
        "window_batch_size": 32
    },
    "trainer_params": {
        "name": "BelongingTrainer",
        "num_epochs": 20,
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "patience": 5,
        "decision_threshold": 0.5,
        "threshold_strategy": null,
        "use_validation_during_training": false
    },
    "grid_search": {
        "metric": "accuracy",
        "params": {
            "trainer_params.learning_rate": [0.001, 0.0003],
            "model_params.dropout_rate": [0.2, 0.4],
            "model_params.lstm_hidden_size": [16, 32]
        }
    }
}
